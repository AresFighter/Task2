<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.collections.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.canvas.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="826.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.task2.Controller">
  <top>
    <VBox alignment="CENTER" prefHeight="308.0" prefWidth="700.0" spacing="20.0">
      <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
      </padding>
      <HBox prefHeight="34.0" prefWidth="660.0">
        <children>
          <Button fx:id="" mnemonicParsing="false" onAction="#cleanCan" style="-fx-background-radius: 8; -fx-background-color: red;" text="Очистить" />
          <Button fx:id="buttonCancel" mnemonicParsing="false" onAction="#undo" style="-fx-background-radius: 8;" text="Назад">
            <HBox.margin>
              <Insets left="10.0" />
            </HBox.margin>
          </Button>
          <Button mnemonicParsing="false" onAction="#redo" style="-fx-background-radius: 8;" text="Далее">
            <HBox.margin>
              <Insets left="10.0" />
            </HBox.margin>
          </Button>
        </children>
        <padding>
          <Insets left="230.0" right="227.0" />
        </padding>
      </HBox>
      <VBox prefHeight="355.0" prefWidth="660.0" >
        <children>
          <!-- HBox для объединения ListView и остальных элементов -->
          <HBox spacing="10.0">
            <!-- ListView слева -->
            <ListView fx:id="listView" maxHeight="180.0" maxWidth="300.0" prefHeight="100.0" prefWidth="300.0" />
            <!-- Остальные элементы справа -->
            <VBox spacing="10.0">
              <HBox prefHeight="26.0" prefWidth="660.0">
                <children>
                  <Label text="Размер фигуры:" />
                  <TextField fx:id="sizeField" maxWidth="-Infinity" prefHeight="26.0" prefWidth="100.0">
                    <HBox.margin>
                      <Insets left="10.0" />
                    </HBox.margin>
                  </TextField>
                  <Button mnemonicParsing="false" onAction="#applySize" style="-fx-background-radius: 8;" text="Применить">
                    <HBox.margin>
                      <Insets left="10.0" />
                    </HBox.margin>
                  </Button>
                  <Label text="Цвет контура:">
                    <padding>
                      <Insets left="10.0" />
                    </padding>
                  </Label>
                  <ColorPicker fx:id="outlineColorPicker" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="26.0" prefWidth="116.0">
                    <HBox.margin>
                      <Insets left="10.0" />
                    </HBox.margin>
                    <padding>
                      <Insets left="20.0" />
                    </padding>
                  </ColorPicker>
                </children>
              </HBox>
              <HBox prefHeight="27.0" prefWidth="660.0">
                <children>
                  <Label text="Размер контура:" />
                  <TextField fx:id="outlineSizeField" prefHeight="26.0" prefWidth="100.0">
                    <HBox.margin>
                      <Insets left="7.0" />
                    </HBox.margin>
                  </TextField>
                </children>
              </HBox>
              <HBox prefHeight="37.0" prefWidth="660.0">
                <children>
                  <Label text="Тип заливки фигуры:">
                    <HBox.margin>
                      <Insets />
                    </HBox.margin>
                  </Label>
                  <ComboBox fx:id="fillTypeComboBox" prefWidth="150.0">
                    <items>
                      <FXCollections fx:factory="observableArrayList">
                        <String fx:value="solid" />
                        <String fx:value="gradient" />
                      </FXCollections>
                    </items>
                    <HBox.margin>
                      <Insets left="10.0" />
                    </HBox.margin>
                  </ComboBox>
                  <CheckBox fx:id="animationCheckBox" mnemonicParsing="false" text="Добавить анимацию">
                    <HBox.margin>
                      <Insets left="10.0" />
                    </HBox.margin>
                  </CheckBox>
                </children>
              </HBox>
              <HBox prefHeight="100.0" prefWidth="200.0">
                <children>
                  <VBox fx:id="solidColorBox" visible="false">
                    <Label text="Solid Color:" />
                    <ColorPicker fx:id="solidColorPicker" />
                  </VBox>
                  <VBox fx:id="gradientColorBox" visible="false">
                    <Label text="Gradient Colors:" />
                    <ColorPicker fx:id="gradientColorPicker1" />
                    <ColorPicker fx:id="gradientColorPicker2" />
                  </VBox>
                  <VBox fx:id="patternColorBox" visible="false">
                    <Label text="Pattern:" />
                  </VBox>
                </children>
              </HBox>
            </VBox>
          </HBox>

        </children>
        <VBox.margin>
          <Insets top="10.0" />
        </VBox.margin>
      </VBox>
    </VBox>
  </top>
  <center>
    <Canvas fx:id="canvas" height="479.0" width="600.0" BorderPane.alignment="CENTER">
      <BorderPane.margin>
        <Insets top="2.0" />
      </BorderPane.margin>
    </Canvas>
  </center>
</BorderPane>
